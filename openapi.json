{
  "openapi": "3.1.0",
  "info": {
    "title": "Verity 家庭财富引擎 E0 接口契约",
    "version": "0.2.0",
    "summary": "家庭财富结果的决策支持接口：先算清楚什么会摧毁这个家庭，再谈方案。",
    "description": "Verity 是家庭财富结果的决策支持引擎：先理解家庭如何生活、赚钱与承担家庭责任，再计算哪些风险会摧毁这个家庭，最后才寻找能穿过这些风险的方案。\n\n本契约只描述接口的形状与语义，不构成任何投资、法律、税务或保险建议；引擎不推荐任何具体证券、基金、保险产品或机构，不执行任何交易。\n\n三条与实现绑定的硬约束：\n1. 拒绝也是成功：判定为拒绝作答时，返回成功状态码与完整证据，而不是传输层错误；\n2. 永不抛出：输入畸形时以失败关闭作答，不返回服务端错误；\n3. 无生产权限：每个响应都带安全姿态响应头，见下方响应头清单。"
  },
  "servers": [
    {
      "url": "/",
      "description": "同源部署：静态预览与控制台由同一个根路径提供。"
    }
  ],
  "tags": [
    {
      "name": "系统",
      "description": "存活自检、接口契约与安全姿态。"
    },
    {
      "name": "家庭数据",
      "description": "读取样本家庭档案与校验家庭输入。"
    },
    {
      "name": "决策",
      "description": "运行引擎、批量复核与证据审计。"
    },
    {
      "name": "合作与反馈",
      "description": "对外审计规格与用户反馈。此类接口不代表已生效的合作关系。"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "系统"
        ],
        "summary": "存活与安全姿态自检",
        "operationId": "getHealthz",
        "description": "返回服务是否存活、引擎版本、合成样本家庭数量、本会话已记录的结果数，以及生产权限与发布闸门的当前值。这是唯一不需要读取家庭数据的接口；它只接受读取，不写入任何状态。",
        "responses": {
          "200": {
            "description": "成功。业务层的拒绝（ABSTAIN）也走 200，并带完整证据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/openapi.json": {
      "get": {
        "tags": [
          "系统"
        ],
        "summary": "本接口契约的机器可读描述",
        "operationId": "getOpenApiDocument",
        "description": "返回 OpenAPI 3.1 描述文件本体。文档由路由表生成，因此描述的路径与服务器真正接受的路径同源，不会各自漂移。扩展字段 x-verity 记录引擎版本、产品版本、安全姿态与版本化政策。",
        "responses": {
          "200": {
            "description": "成功。业务层的拒绝（ABSTAIN）也走 200，并带完整证据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenApiDocument"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/docs": {
      "get": {
        "tags": [
          "系统"
        ],
        "summary": "接口契约的可读页面",
        "operationId": "getApiDocs",
        "description": "把同一份描述文件渲染成可直接阅读的页面，含端点清单、字段约束与安全姿态。",
        "responses": {
          "200": {
            "description": "成功。业务层的拒绝（ABSTAIN）也走 200，并带完整证据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiDocsPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/contract": {
      "get": {
        "tags": [
          "系统"
        ],
        "summary": "机器可读的能力清单与阈值",
        "operationId": "getContract",
        "description": "返回判定取值、动作取值、必填字段、压力情景清单、判定阈值与端点清单，供前端与集成方在启动时校验能力是否一致。",
        "responses": {
          "200": {
            "description": "成功。业务层的拒绝（ABSTAIN）也走 200，并带完整证据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contract"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/synthetic": {
      "get": {
        "tags": [
          "家庭数据"
        ],
        "summary": "列出全部合成样本家庭",
        "operationId": "listSyntheticHouseholds",
        "description": "列出样本家庭的编号、设计分层与设计预期判定，不返回完整档案。",
        "responses": {
          "200": {
            "description": "成功。业务层的拒绝（ABSTAIN）也走 200，并带完整证据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyntheticIndex"
                }
              }
            }
          },
          "503": {
            "description": "依赖的本机合成样本数据集缺失。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/household/profile/{profile_id}": {
      "get": {
        "tags": [
          "家庭数据"
        ],
        "summary": "按编号读取一份完整家庭档案",
        "operationId": "getHouseholdProfile",
        "description": "返回合成样本家庭或示范家庭的完整档案原文，用于复核引擎输入。",
        "responses": {
          "200": {
            "description": "成功。业务层的拒绝（ABSTAIN）也走 200，并带完整证据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HouseholdProfileRecord"
                }
              }
            }
          },
          "404": {
            "description": "目标资源不存在（编号未知，或运行编号已随会话结束失效）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "依赖的本机合成样本数据集缺失。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "profile_id",
            "in": "path",
            "required": true,
            "description": "家庭档案编号，例如 SYN-N01 或 SYN-DP01。",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/api/v0/household/validate": {
      "post": {
        "tags": [
          "家庭数据"
        ],
        "summary": "校验家庭档案是否可被引擎接受",
        "operationId": "validateHouseholdProfile",
        "description": "只做校验，不运行引擎。返回是否有效、缺失的必填项、前后不一致项与提示项，并附证据块。校验失败同样是 200，由 valid=false 表达。",
        "responses": {
          "200": {
            "description": "成功。业务层的拒绝（ABSTAIN）也走 200，并带完整证据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          },
          "400": {
            "description": "请求体不是合法 JSON、不是对象、为空或超出体积上限。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "见 schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "见 schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateRequest"
              }
            }
          }
        }
      }
    },
    "/api/v0/analyze": {
      "post": {
        "tags": [
          "决策"
        ],
        "summary": "对一份家庭档案运行完整决策引擎",
        "operationId": "analyzeHousehold",
        "description": "这是产品的主接口：输入一份家庭档案，返回判定、分层、安全性、可行性、配置、压力测试、今日行动、保险审计、风险排序、趋势、危险时间轴、证据与审计记录。结果按服务端生成的运行编号记入内存，可用证据接口复核；请求体里的 run_id 一律忽略。判定为 ABSTAIN 时仍返回 200。写接口需要认证：部署方声明写令牌后必须携带令牌，未声明时只有本机回环来源可以写入；超过并发或频率上限时返回 429 与 Retry-After。",
        "responses": {
          "200": {
            "description": "成功。业务层的拒绝（ABSTAIN）也走 200，并带完整证据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResult"
                }
              }
            }
          },
          "400": {
            "description": "请求体不是合法 JSON、不是对象、为空或超出体积上限。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "见 schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "见 schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          }
        },
        "x-verity-state-change": true
      }
    },
    "/api/v0/cohort/run": {
      "post": {
        "tags": [
          "决策"
        ],
        "summary": "对全部合成样本家庭批量运行引擎",
        "operationId": "runCohort",
        "description": "对 50 个样本家庭逐个运行引擎，返回逐户判定与「是否与设计预期一致」的汇总。每户的运行编号由服务端生成，客户端不能指定。写接口需要认证，超限返回 429。",
        "responses": {
          "200": {
            "description": "成功。业务层的拒绝（ABSTAIN）也走 200，并带完整证据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CohortRunResult"
                }
              }
            }
          },
          "403": {
            "description": "见 schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "见 schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "依赖的本机合成样本数据集缺失。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CohortRequest"
              }
            }
          }
        },
        "x-verity-state-change": true
      }
    },
    "/api/v0/evidence/{run_id}": {
      "get": {
        "tags": [
          "决策"
        ],
        "summary": "按运行编号复核证据与审计链",
        "operationId": "getEvidence",
        "description": "返回该次运行的证据块、审计记录与哈希链是否自洽。结果只在本次会话的内存中保留，进程重启即失效（服务端不落盘家庭资料）。",
        "responses": {
          "200": {
            "description": "成功。业务层的拒绝（ABSTAIN）也走 200，并带完整证据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceLookup"
                }
              }
            }
          },
          "404": {
            "description": "目标资源不存在（编号未知，或运行编号已随会话结束失效）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "description": "运行编号，来自 analyze 或 cohort/run 的返回。",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/api/v0/partner/audit-schema": {
      "get": {
        "tags": [
          "合作与反馈"
        ],
        "summary": "对外审计接口的规格说明",
        "operationId": "getPartnerAuditSchema",
        "description": "描述把审计记录交给持牌合作方时的接口规格与数据最小化约束。这是规格而非已生效协议：Verity 目前不持有牌照，也未签署任何合作方协议。",
        "responses": {
          "200": {
            "description": "成功。业务层的拒绝（ABSTAIN）也走 200，并带完整证据。",

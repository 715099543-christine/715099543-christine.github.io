  },
  "components": {
    "schemas": {
      "HouseholdProfile": {
        "type": "object",
        "description": "家庭档案。必填项缺失不会导致接口报错，而是让引擎以 ABSTAIN 作答。",
        "required": [
          "members",
          "annual_expenses_essential",
          "assets",
          "investment_horizon_years",
          "target_annual_return",
          "max_tolerable_loss_pct"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "description": "档案编号，可选；引擎会回显。"
          },
          "currency": {
            "type": "string",
            "description": "计价币种代码，例如 USD、CNY。"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "description": "家庭成员。每人的收入与收入稳定性决定压力情景能否测算。",
            "items": {
              "type": "object",
              "required": [
                "annual_income"
              ],
              "properties": {
                "member_id": {
                  "type": "string"
                },
                "age": {
                  "type": "integer",
                  "minimum": 0
                },
                "role": {
                  "type": "string",
                  "examples": [
                    "primary_earner",
                    "partner",
                    "dependent"
                  ]
                },
                "dependents": {
                  "type": "integer",
                  "minimum": 0
                },
                "annual_income": {
                  "type": "number",
                  "minimum": 0
                },
                "income_stability": {
                  "type": "string",
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "annual_expenses_essential": {
            "type": "number",
            "minimum": 0,
            "description": "每年**必要**支出。生存天数与生存底线都建立在这个数字上。"
          },
          "annual_expenses_discretionary": {
            "type": "number",
            "minimum": 0,
            "description": "每年可选支出，可压缩。"
          },
          "assets": {
            "type": "array",
            "description": "资产清单。流动性决定它能否计入生存底线。",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "asset_id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "cash",
                    "bond",
                    "global_index",
                    "equity",
                    "gold",
                    "option_protection",
                    "insurance_linked",
                    "illiquid"
                  ]
                },
                "value": {
                  "type": "number"
                },
                "liquidity": {
                  "type": "string",
                  "enum": [
                    "immediate",
                    "near",
                    "cannot_touch"
                  ]
                },
                "note": {
                  "type": "string"
                },
                "currency": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "liabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "balance"
              ],
              "properties": {
                "liability_id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "mortgage",
                    "consumer",
                    "margin",
                    "student",
                    "other"
                  ]
                },
                "balance": {
                  "type": "number"
                },
                "annual_rate": {
                  "type": "number"
                },
                "mandatory_payment": {
                  "type": "number",
                  "description": "每年强制还款额，参与债务压力比。"
                }
              },
              "additionalProperties": true
            }
          },
          "protection": {
            "type": "array",
            "description": "已记录的保障。保险只是综合保护方案中的一个模块，不是产品中心。",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "coverage"
              ],
              "properties": {
                "protection_id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "life",
                    "disability",
                    "health",
                    "property",
                    "liability"
                  ]
                },
                "coverage": {
                  "type": "number"
                },
                "annual_premium": {
                  "type": "number"
                },
                "exclusions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "future_rigid_outflows": {
            "type": "array",
            "description": "未来刚性支出（教育、赡养等），进入近期待履行义务层。",
            "items": {
              "type": "object",
              "required": [
                "amount",
                "years_until_due"
              ],
              "properties": {
                "outflow_id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                },
                "years_until_due": {
                  "type": "number"
                }
              },
              "additionalProperties": true
            }
          },
          "investment_horizon_years": {
            "type": "number",
            "minimum": 0
          },
